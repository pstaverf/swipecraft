{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "swipecraft:boss_aura",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particles/boss_aura"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 24,
        "max_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.45
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 1.5,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + math.random(0.4)"
      },
      "minecraft:particle_initial_speed": 1.1,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 1.6, 0],
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.16 + variable.particle_random_1 * 0.14", "0.16 + variable.particle_random_1 * 0.14"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["0.95", "0.22 + variable.particle_random_2 * 0.25", "0.16", "0.9"]
      }
    }
  }
}
