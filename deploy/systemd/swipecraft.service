[Unit]
Description=Swipecraft Bedrock Dedicated Server (NetherNet)
Documentation=file:///srv/swipecraft/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bedrock
Group=bedrock
WorkingDirectory=/srv/swipecraft/server
Environment=LD_LIBRARY_PATH=/srv/swipecraft/server
Environment=CONSOLE_FIFO=/run/swipecraft/console.fifo
Environment=HOME=/srv/swipecraft
RuntimeDirectory=swipecraft
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/srv/swipecraft/deploy/run-bds.sh
ExecStop=/srv/swipecraft/deploy/stop-bds.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=180
TimeoutStopSec=120
LimitNOFILE=65535
LimitNPROC=8192
LimitCORE=0
OOMScoreAdjust=-500
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2
MemoryHigh=6G
MemoryMax=7G
TasksMax=8192
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/srv/swipecraft
StandardOutput=append:/srv/swipecraft/logs/console.log
StandardError=append:/srv/swipecraft/logs/console.log

[Install]
WantedBy=multi-user.target
